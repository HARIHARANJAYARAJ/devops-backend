pipeline {
    agent any

    environment {
        IMAGE_NAME = 'hariharan1112/student-backend'
        SERVICE_NAME = 'student-backend'
        DATABASE_URL = 'postgresql://student:studentpass@postgres:5432/studentdb'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                        -t ${IMAGE_NAME}:${BUILD_NUMBER} \
                        -t ${IMAGE_NAME}:latest \
                        .
                '''
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin

                        docker push ${IMAGE_NAME}:${BUILD_NUMBER}
                        docker push ${IMAGE_NAME}:latest

                        docker logout
                    '''
                }
            }
        }

        stage('Database Migration') {
            steps {
                sh '''
                    docker run --rm \
                        --network student-network \
                        -e DATABASE_URL="${DATABASE_URL}" \
                        ${IMAGE_NAME}:${BUILD_NUMBER} \
                        alembic upgrade head
                '''
            }
        }

        stage('Deploy Backend to Swarm') {
            steps {
                sh '''
                    if docker service inspect ${SERVICE_NAME} >/dev/null 2>&1; then

                        echo "Updating existing Swarm service..."

                        docker service update \
                            --image ${IMAGE_NAME}:${BUILD_NUMBER} \
                            --env-add DATABASE_URL="${DATABASE_URL}" \
                            --update-parallelism 1 \
                            --update-delay 5s \
                            --update-order start-first \
                            --rollback-parallelism 1 \
                            --rollback-order start-first \
                            ${SERVICE_NAME}

                    else

                        echo "Creating new Swarm service..."

                        docker service create \
                            --name ${SERVICE_NAME} \
                            --network student-network \
                            --env DATABASE_URL="${DATABASE_URL}" \
                            --publish published=8000,target=8000 \
                            --replicas 2 \
                            --update-parallelism 1 \
                            --update-delay 5s \
                            --update-order start-first \
                            --rollback-parallelism 1 \
                            --rollback-order start-first \
                            ${IMAGE_NAME}:${BUILD_NUMBER}

                    fi
                '''
            }
        }

        stage('Wait for Swarm') {
            steps {
                sh '''
                    echo "Waiting for backend replicas..."

                    for i in $(seq 1 30); do

                        RUNNING=$(docker service ls \
                            --filter name=${SERVICE_NAME} \
                            --format "{{.Replicas}}")

                        echo "Backend replicas: ${RUNNING}"

                        if [ "$RUNNING" = "2/2" ]; then
                            echo "Backend is running with 2/2 replicas."
                            break
                        fi

                        sleep 2

                    done
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    echo "Checking backend API..."

                    for i in $(seq 1 30); do

                        if curl -fsS http://localhost:8000/ >/dev/null; then
                            echo "Backend health check: SUCCESS"
                            curl -fsS http://localhost:8000/
                            break
                        fi

                        echo "Waiting for backend API..."
                        sleep 2

                        if [ "$i" -eq 30 ]; then
                            echo "Backend health check FAILED"
                            exit 1
                        fi

                    done
                '''
            }
        }

        stage('Show Swarm Status') {
            steps {
                sh '''
                    echo "======================================"
                    echo "BACKEND SWARM SERVICE"
                    echo "======================================"

                    docker service ls

                    echo ""
                    echo "======================================"
                    echo "BACKEND TASKS"
                    echo "======================================"

                    docker service ps ${SERVICE_NAME}

                    echo ""
                    echo "======================================"
                    echo "BACKEND DEPLOYMENT SUCCESSFUL"
                    echo "======================================"
                '''
            }
        }
    }

    post {
        success {
            echo 'Backend CI/CD pipeline completed successfully!'
        }

        failure {
            echo 'Backend CI/CD pipeline FAILED!'
        }
    }
}